{
  "name": "gaslamp",
  "version": "1.1.0",
  "description": "Minimal MCP server that lets Claude and Codex talk to each other.",
  "type": "module",
  "bin": {
    "gaslamp": "bin/gaslamp.mjs"
  },
  "exports": {
    ".": "./src/server.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "for f in bin/gaslamp.mjs src/*.mjs tests/*.mjs; do node -c \"$f\"; done",
    "setup": "node bin/gaslamp.mjs setup",
    "doctor": "node bin/gaslamp.mjs doctor"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "codex",
    "llm",
    "agent",
    "ai",
    "code-review",
    "stdio"
  ],
  "author": "a9lim <mx@a9l.im>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/a9lim/gaslamp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a9lim/gaslamp.git"
  },
  "bugs": {
    "url": "https://github.com/a9lim/gaslamp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {}
}
