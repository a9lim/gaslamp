{
  "name": "gaslamp",
  "version": "2.0.0",
  "description": "Let Claude Code and Codex consult each other from the shell — parallel, background-friendly, resumable.",
  "type": "module",
  "bin": {
    "gaslamp": "bin/gaslamp.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "for f in bin/gaslamp.mjs src/*.mjs tests/*.mjs; do node -c \"$f\"; done",
    "setup": "node bin/gaslamp.mjs setup"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "llm",
    "agent",
    "ai",
    "cli",
    "code-review",
    "consult"
  ],
  "author": "a9lim <mx@a9l.im>",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/a9lim/gaslamp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a9lim/gaslamp.git"
  },
  "bugs": {
    "url": "https://github.com/a9lim/gaslamp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {}
}
